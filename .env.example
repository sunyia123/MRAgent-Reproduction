# === MRAgent Provider Configuration ===
# Copy to .env and fill in your API key (choose ONE provider block).
# .env is git-ignored — never commit your API key.

# --- Provider A: SiliconFlow (deepseek / qwen models) ---
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_MODEL_ID=deepseek-ai/DeepSeek-V4-Pro
# QWEN_MODEL_ID=Qwen/Qwen3.5-397B-A17B
# VLM_MODEL=Qwen/Qwen3.5-397B-A17B
# EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# --- Provider B: OpenRouter ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-v1-xxx
# EMBED_MODEL=text-embedding-3-large

# --- Shared (optional) ---
# EMBED_BASE_URL=https://api.siliconflow.cn/v1   # separate embed provider; defaults to LLM_BASE_URL
# VLM_MAX_TOKENS=1024
